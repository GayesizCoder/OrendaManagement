@model IEnumerable<Orenda.Web.Models.Cihaz>
@{
    ViewData["Title"] = "Cihaz Yönetimi";
}

<div class="container-fluid pe-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
              <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Management" class="text-purple text-decoration-none">Yönetim</a></li>
                <li class="breadcrumb-item active text-white-50" aria-current="page">Cihaz Yönetimi</li>
              </ol>
            </nav>
            <h2 class="fw-bold mb-0">Demirbaş & Cihaz Yönetimi</h2>
        </div>
        <button class="btn btn-purple rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addDeviceModal">
            <i class="bi bi-plus-lg me-2"></i> Yeni Cihaz Ekle
        </button>
    </div>

    <div class="row g-4">
        @foreach (var device in Model)
        {
            <div class="col-md-4 col-lg-3">
                <div class="glass-panel p-4 h-100 d-flex flex-column transition-hover">
                    <div class="d-flex justify-content-between mb-3">
                        @{
                            string icon = device.Tür switch {
                                "Laptop" => "bi-laptop",
                                "Telefon" => "bi-phone",
                                "Wearable" => "bi-watch",
                                _ => "bi-cpu"
                            };
                            string statusColor = device.Durum switch {
                                "Müsait" => "text-success",
                                "Kullanımda" => "text-info",
                                "Arızalı" => "text-danger",
                                _ => "text-warning"
                            };
                        }
                        <div class="bg-dark bg-opacity-50 rounded p-2 text-white">
                            <i class="bi @icon fs-4"></i>
                        </div>
                        <span class="small @statusColor fw-bold"><i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i> @device.Durum</span>
                    </div>

                    <h6 class="fw-bold text-white mb-1">@device.CihazAdi</h6>
                    <small class="text-white-50 d-block mb-3">S/N: @device.SeriNo</small>

                    <div class="mt-auto border-top border-secondary border-opacity-10 pt-3">
                        @if (device.AtananCalisanID.HasValue)
                        {
                            <div class="d-flex align-items-center mb-3">
                                <img src="https://ui-avatars.com/api/?name=@(device.AtananCalisan?.Ad)+@(device.AtananCalisan?.Soyad)&background=random&color=fff&size=24" class="rounded-circle me-2" style="width: 24px; height: 24px;">
                                <small class="text-white-50">@device.AtananCalisan?.Ad @device.AtananCalisan?.Soyad</small>
                            </div>
                            <form asp-action="AssignDevice" method="post">
                                <input type="hidden" name="cihazId" value="@device.CihazID" />
                                <input type="hidden" name="calisanId" value="" />
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-pill">Zimmeti Kaldır</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="AssignDevice" method="post">
                                <input type="hidden" name="cihazId" value="@device.CihazID" />
                                <div class="input-group input-group-sm mb-2">
                                    <select name="calisanId" class="form-select bg-dark text-white border-secondary small">
                                        <option value="">Atanacak Kişi Seç...</option>
                                        @foreach (var emp in (IEnumerable<Orenda.Web.Models.Kullanici>)ViewBag.Employees)
                                        {
                                            <option value="@emp.CalisanID">@emp.Ad @emp.Soyad</option>
                                        }
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-sm btn-purple w-100 rounded-pill">Zimmetle</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Add Device Modal -->
<div class="modal fade" id="addDeviceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary shadow-lg">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-white fw-bold">Yeni Cihaz Kaydı</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddDevice" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-white-50">Cihaz Adı</label>
                        <input type="text" name="CihazAdi" class="form-control bg-dark text-white border-secondary" required placeholder="Örn: MacBook Pro 14">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50">Seri Numarası</label>
                        <input type="text" name="SeriNo" class="form-control bg-dark text-white border-secondary" required placeholder="Örn: ABC123XYZ">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50">Cihaz Türü</label>
                        <select name="Tür" class="form-select bg-dark text-white border-secondary">
                            <option value="Laptop">Laptop</option>
                            <option value="Telefon">Telefon</option>
                            <option value="Wearable">Wearable (Watch)</option>
                            <option value="Monitör">Monitör</option>
                            <option value="Diğer">Diğer</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-purple rounded-pill px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>
